# Copy to .env and fill in. Never commit .env.

# --- Django -------------------------------------------------------------
# Required when DJANGO_DEBUG=false. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when serving from a different origin/port behind HTTPS, e.g. https://sql.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Production behind a TLS-terminating proxy:
# DJANGO_BEHIND_PROXY=true
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# Shared cache for rate limits and retrieval cache (recommended in production)
# DJANGO_CACHE_URL=redis://localhost:6379/1
LOG_LEVEL=INFO

# --- Target database (the one users query) ------------------------------
# Use a least-privilege account with SELECT only. See README.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

SQL_QUERY_TIMEOUT_SECONDS=15
SQL_MAX_ROWS=500
SQL_DEFAULT_LIMIT=100
# Optional comma-separated allow/deny lists
SQL_ALLOWED_TABLES=
SQL_DENIED_TABLES=
SQL_DENIED_TABLE_PREFIXES=auth_,django_,authtoken_

# --- LLM / embeddings ---------------------------------------------------
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-2-preview
# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store -------------------------------------------------------
VECTOR_STORE=redis
REDIS_URL=redis://localhost:6379
VECTOR_INDEX_NAME=mysql_schema
# VECTOR_STORE=chroma
# CHROMA_DIR=./chroma_mysql

# --- Retrieval / indexing -----------------------------------------------
RETRIEVAL_K=10
MAX_CONTEXT_TABLES=8
MAX_CONTEXT_CHARS=16000
RETRIEVAL_CACHE_SECONDS=3600
CHAT_HISTORY_TURNS=3
SCHEMA_SAMPLE_ROWS=3
EMBEDDING_BATCH_SIZE=5
EMBEDDING_BATCH_DELAY_SECONDS=5

# --- Access control -----------------------------------------------------
TEXT_TO_SQL_REQUIRE_PERMISSION=true
TEXT_TO_SQL_RATE_LIMIT_PER_MINUTE=20

# --- docker compose only ------------------------------------------------
# Where the web container finds MySQL. Default: your host machine.
# With `--profile local-db` set COMPOSE_DB_HOST=mysql (and COMPOSE_DB_PORT=3306).
COMPOSE_DB_HOST=host.docker.internal
COMPOSE_DB_PORT=3306
# Root password for the bundled MySQL (local-db profile only).
MYSQL_ROOT_PASSWORD=
